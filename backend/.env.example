# Copy to .env and adjust. Never commit a real .env file.
# Production values are injected by the platform; see docs/deployment.md.

NODE_ENV=development
PORT=3000

# Local MongoDB (see infrastructure/docker-compose.yml).
# Production uses a managed MongoDB Atlas cluster, injected from Secret Manager.
MONGODB_URI=mongodb://localhost:27017/roxstar

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Milliseconds between spin eliminations. 5000 is the cadence the assessment
# requires; the integration tests inject a smaller value for speed.
SPIN_ELIMINATION_INTERVAL_MS=5000

# Only used by the integration suite; defaults to a roxstar_test database.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/roxstar_test
